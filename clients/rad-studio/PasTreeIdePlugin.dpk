package PasTreeIdePlugin;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$IMPLICITBUILD ON}

{ This is the name RAD Studio shows for the package in Component > Install
  Packages. Without it the list falls back to the full path of the .bpl, which
  is both ugly and useless for telling one entry from another - and now that
  the file lives under out\<version>\, that path is longer still. The IDE reads
  it from the compiled package, not from the registry, so the description
  written into Known Packages by install.bat is a separate string; keep the two
  saying the same thing. }
{$DESCRIPTION 'PasTree LSP - Object Pascal code intelligence'}

{ Design-time only, and this is a statement of fact rather than a preference:
  the package requires designide and consists of ToolsAPI wizards, so there is
  nothing in it a compiled application could use. Marking it says so to the
  IDE, which then keeps it out of the Runtime Packages a project can be built
  against - where adding it would produce a link against designide and a
  program that cannot run outside the IDE. }
{$DESIGNONLY}

{ The product mark, used by the splash line and the settings dialog. Separate
  from the $R *.res above, which is the version-info resource msbuild
  generates; this one is compiled from a tracked .rc so the image survives a
  fresh clone. See PasTreeIdePlugin.Logo.rc. }
{$R PasTreeIdePlugin.Logo.res}

requires
  rtl,
  vcl,
  designide;

{ The ~20 PasTree.*.pas analysis units are GONE from this package as of the LSP
  move: the analysis runs in pastree-server.exe (Win64) now, so a Win32
  designtime package has no reason to link a parser it cannot usefully run at
  the target project's scale. That also drops this repo's build-time dependency
  on a sibling object-pascal-tree checkout - the server owns it instead. }
contains
  { The two units this package takes from outside its own directory, and the
    only two it may. Each is dependency-free BY CONSTRUCTION - see their own
    headers - because this is a Win32 designtime package and anything they
    reached for could drag in PasTree, which is Win64-only. tests/VersionSmoke
    links both into a Win32 program so that a `uses` line creeping into either
    one breaks a build rather than the IDE. }
  PasLsp.ProductVersion in '..\..\source\PasLsp.ProductVersion.pas',
  PasLsp.SourceText in '..\..\source\PasLsp.SourceText.pas',
  PasTreeIdePlugin.Wizard in 'PasTreeIdePlugin.Wizard.pas',
  PasTreeIdePlugin.LspTransport in 'PasTreeIdePlugin.LspTransport.pas',
  PasTreeIdePlugin.LspClient in 'PasTreeIdePlugin.LspClient.pas',
  PasTreeIdePlugin.LspDocuments in 'PasTreeIdePlugin.LspDocuments.pas',
  PasTreeIdePlugin.LspSession in 'PasTreeIdePlugin.LspSession.pas',
  PasTreeIdePlugin.FindReferences in 'PasTreeIdePlugin.FindReferences.pas',
  PasTreeIdePlugin.FindHierarchy in 'PasTreeIdePlugin.FindHierarchy.pas',
  PasTreeIdePlugin.ResultRows in 'PasTreeIdePlugin.ResultRows.pas',
  PasTreeIdePlugin.WaitDialog in 'PasTreeIdePlugin.WaitDialog.pas',
  PasTreeIdePlugin.GotoDeclaration in 'PasTreeIdePlugin.GotoDeclaration.pas',
  PasTreeIdePlugin.CodeInsight in 'PasTreeIdePlugin.CodeInsight.pas',
  PasTreeIdePlugin.IdeInsight in 'PasTreeIdePlugin.IdeInsight.pas',
  PasTreeIdePlugin.ErrorPaint in 'PasTreeIdePlugin.ErrorPaint.pas',
  PasTreeIdePlugin.IdleSync in 'PasTreeIdePlugin.IdleSync.pas',
  PasTreeIdePlugin.Timing in 'PasTreeIdePlugin.Timing.pas',
  PasTreeIdePlugin.Outline in 'PasTreeIdePlugin.Outline.pas',
  PasTreeIdePlugin.ClassComplete in 'PasTreeIdePlugin.ClassComplete.pas',
  PasTreeIdePlugin.SyncPrototypes in 'PasTreeIdePlugin.SyncPrototypes.pas',
  PasTreeIdePlugin.BlockClose in 'PasTreeIdePlugin.BlockClose.pas',
  PasTreeIdePlugin.EditorWindowHook in 'PasTreeIdePlugin.EditorWindowHook.pas',
  PasTreeIdePlugin.Rename in 'PasTreeIdePlugin.Rename.pas',
  { The settings store, and the ONE form in this package - the only unit here
    with a .dfm, so that the dialog can be laid out in the Form Designer
    rather than in code. See PasTreeIdePlugin.SettingsForm's header. }
  PasTreeIdePlugin.Settings in 'PasTreeIdePlugin.Settings.pas',
  PasTreeIdePlugin.SettingsForm in 'PasTreeIdePlugin.SettingsForm.pas' {PasTreeSettingsForm},
  { Every AV in the IDE, with a stack, beside the server log - see the unit. }
  PasTreeIdePlugin.CrashLog in 'PasTreeIdePlugin.CrashLog.pas',
  { The startup splash line. Nothing uses this unit - it acts from its own
    initialization section - so it is here purely to be linked. }
  PasTreeIdePlugin.Splash in 'PasTreeIdePlugin.Splash.pas';

end.
